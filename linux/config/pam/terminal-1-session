# PAM stack for the Terminal 1 kiosk session (terminal-1-session.service).
# systemd only runs the account and session stacks for PAMName=; nothing may authenticate here.
# pam_systemd registers a logind session so cage gets the seat (DRM, input).
auth     required  pam_deny.so
account  include   common-account
session  include   common-session
session  required  pam_systemd.so
session  optional  pam_keyinit.so force revoke
