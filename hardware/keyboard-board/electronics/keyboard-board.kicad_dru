(version 1)
(rule "THT ground pads: one spoke is enough (joined on both layers)"
  (condition "A.Type == 'Pad' && A.NetName == '/GND'")
  (constraint min_resolved_spokes 1))
(rule "Keyboard connector: 0.4 mm pitch pads are 0.17 mm apart (Hirose land pattern)"
  (condition "A.Type == 'Pad' && B.Type == 'Pad' && A.Parent == 'J3' && B.Parent == 'J3'")
  (constraint clearance (min 0.12)))
